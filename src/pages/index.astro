---
import PeakLayout from "../layouts/PeakLayout.astro";
import FinalCta from "../components/FinalCta.astro";
import HeroWorkShot from "../components/HeroWorkShot.astro";
import HomeBeforeAfter from "../components/HomeBeforeAfter.astro";
import HomeOwnerCallout from "../components/HomeOwnerCallout.astro";
import HomeOfferSection from "../components/HomeOfferSection.astro";
import RecentWork from "../components/RecentWork.astro";
import PricingPlans from "../components/PricingPlans.astro";
import { splitPartial } from "../lib/partial";
import "../styles/peak-home.css";
import html from "../partials/home-main.html?raw";

const [
  beforeHeroVisual,
  betweenVisualAndBeforeAfter,
  betweenBeforeAfterAndOwner,
  betweenOwnerAndOffer,
  betweenOfferAndTestimonials,
  betweenTestimonialsAndPricing,
  afterPricing,
  afterFinalCta,
] = splitPartial(
  html,
  "home-main.html",
  "<!--HERO_VISUAL-->",
  "<!--BEFORE_AFTER-->",
  "<!--OWNER_CALLOUT-->",
  "<!--OFFER_SECTION-->",
  "<!--TESTIMONIALS-->",
  "<!--PRICING_PLANS-->",
  "<!--FINAL_CTA-->",
);
---

<PeakLayout
  title="Small Business Web Design in Marietta, GA | $80 Per Page"
  description="Custom websites for small businesses at $80 per designed page, with unlimited revisions and a money back guarantee. Local SEO with a refund if agreed targets are not met."
  canonicalPath="/"
>
  <Fragment set:html={beforeHeroVisual} />
  <HeroWorkShot />
  <Fragment set:html={betweenVisualAndBeforeAfter} />
  <HomeBeforeAfter />
  <Fragment set:html={betweenBeforeAfterAndOwner} />
  <HomeOwnerCallout />
  <Fragment set:html={betweenOwnerAndOffer} />
  <HomeOfferSection />
  <Fragment set:html={betweenOfferAndTestimonials} />
  <RecentWork tone="base" id="work" />
  <Fragment set:html={betweenTestimonialsAndPricing} />
  <PricingPlans variant="home" headingLevel="h3" summary ctaLabel="See Full Pricing" ctaHref="/pricing" />
  <Fragment set:html={afterPricing} />
  <FinalCta heading="Ready To Get The Site You Always Wanted?" ctaLabel="Get Started Today" id="contact" />
  <Fragment set:html={afterFinalCta} />
</PeakLayout>
