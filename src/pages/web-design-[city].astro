---
import PeakLayout from "../layouts/PeakLayout.astro";
import FinalCta from "../components/FinalCta.astro";
import OwnerPhoto from "../components/OwnerPhoto.astro";
import { locations } from "../data/locations";
import { business } from "../data/business";
import "../styles/peak-article.css";

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { city: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;
const path = `/web-design-${location.slug}`;
---

<PeakLayout
  title={`Web Design in ${location.city}, GA | $80 Per Page`}
  description={location.description}
  canonicalPath={path}
>
  <header class="page-header service">
    <div class="stars" aria-hidden="true"></div>
    <div class="page-header-inner">
      <div class="page-header-eyebrow">{location.city}, Georgia</div>
      <h1>Web Design &amp; Local SEO in {location.city}, GA</h1>
      <p class="subtitle">Hand-Coded Sites, No WordPress Or Page Builders</p>
      <p>
        $80 per designed page, unlimited revisions, money back if you are not satisfied.
      </p>
      <a href="/contact?service=free-audit" class="btn-primary">
        Get A Free Site Audit
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </header>

  <section class="content">
    <div class="container">
      <article class="article">
        <p>{location.intro}</p>

        {
          location.sections.map((section) => (
            <>
              <h2>{section.heading}</h2>
              {section.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </>
          ))
        }

        <h2>Who I Build For in {location.city}</h2>
        <ul>
          {location.industries.map((industry) => <li>{industry}</li>)}
        </ul>

        <OwnerPhoto caption={`Websites and local SEO for small businesses in ${location.city} and across the US.`} />

        <h2>What It Costs</h2>
        <p>
          Pricing is the same here as everywhere else. A website redesign is $80 per designed page,
          so a 5 page site is $400, paid half to start and half at launch. Design revisions are
          unlimited, you get an editor to make changes yourself and one month of unlimited support
          after launch, and you get your money back if you are not satisfied with the design. Local
          SEO is $799 per month for four months, with a refund if the agreed targets are not met. The
          <a href="/pricing">pricing page</a> has the full details.
        </p>

        <h2>Where To Start</h2>
        <p>
          Run your current site through Google PageSpeed Insights and see what it scores. Then
          <a href={business.smsHref}>text {business.phoneDisplay}</a> or
          <a href="/contact">send a message</a> and I will go through what is actually holding it
          back. There is no charge for that and no obligation attached to it.
        </p>

        <div class="cross-link">
          <div class="cross-link-label">Related Service</div>
          <h3>Local SEO</h3>
          <p>
            A fast site is the foundation. Getting into the map results for {location.city} searches
            is the ongoing work: Google Business Profile, citations, reviews and a monthly report
            you can actually read.
          </p>
          <a href="/local-seo">
            Learn About Local SEO
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </article>
    </div>
  </section>

  <FinalCta heading={`Ready To Get Found in ${location.city}?`} ctaLabel="Get A Free Site Audit" ctaHref="/contact?service=free-audit" />
</PeakLayout>
