---
import PeakLayout from "../layouts/PeakLayout.astro";
import FinalCta from "../components/FinalCta.astro";
import HomeBeforeAfter from "../components/HomeBeforeAfter.astro";
import PageFaq from "../components/PageFaq.astro";
import { locations } from "../data/locations";
import { trades } from "../data/trades";
import { business } from "../data/business";
import "../styles/peak-article.css";

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { city: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;
const path = `/web-design-${location.slug}`;
const mockupHref = `/free-homepage-mockup?ref=web-design-${location.slug}`;
---

<PeakLayout
  title={`Web Design in ${location.city}, GA | $80 Per Page`}
  description={location.description}
  canonicalPath={path}
>
  <header class="page-header service">
    <div class="stars" aria-hidden="true"></div>
    <div class="page-header-inner">
      <div class="page-header-eyebrow">{location.city}, Georgia</div>
      <h1>Web Design &amp; Local SEO in {location.city}, GA</h1>
      <p class="subtitle">Hand-Coded Sites, No WordPress Or Page Builders</p>
      <p>
        $80 per designed page, unlimited revisions, money back if you are not satisfied.
      </p>
      <a href={mockupHref} class="btn-primary">
        Get A Free Homepage Mockup
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </header>

  <section class="content">
    <div class="container">
      <article class="article">
        <p>{location.intro}</p>

        {
          location.sections.map((section) => (
            <>
              <h2>{section.heading}</h2>
              {section.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </>
          ))
        }

        <h2>Who I Build For in {location.city}</h2>
        <ul>
          {location.industries.map((industry) => <li>{industry}</li>)}
        </ul>

        <h2>Website Plans For Contractors And Trades</h2>
        <p>
          I have written out what a website needs for each of these trades, with a page plan and the
          price. My page on <a href="/websites-for-contractors">websites for contractors</a> covers
          home service businesses in general.
        </p>
        <ul>
          {
            trades.map((trade) => (
              <li>
                <a href={`/web-design-for-${trade.slug}`}>{trade.linkText}</a>
              </li>
            ))
          }
        </ul>

        <h2>Web Design Prices In {location.city}, GA</h2>
        <p>
          Pricing is the same here as everywhere else. A website redesign is $80 per designed page,
          so a 5 page site is $400, paid half to start and half at launch. Design revisions are
          unlimited, you get an editor to make changes yourself and one month of unlimited support
          after launch, and you get your money back if you are not satisfied with the design. Local
          SEO is $799 per month for three months, with a refund if the agreed targets are not met. The
          <a href="/pricing">pricing page</a> has the full details.
        </p>

        <h2>How To Start With A Free Homepage Mockup</h2>
        <p>
          Send me your website address and I will design a new homepage for your business for
          free. There is no charge and no obligation. If you like it, I design the rest of the
          site at $80 per page. <a href={mockupHref}>Request your free mockup</a>, or
          <a href={business.smsHref}>text {business.phoneDisplay}</a>.
        </p>

        {
          location.faq && (
            <PageFaq
              heading={`Questions About Web Design In ${location.city}, GA`}
              items={location.faq}
            />
          )
        }

        <div class="cross-link">
          <div class="cross-link-label">Related Service</div>
          <h3>Local SEO</h3>
          <p>
            A fast site is the foundation. Getting into the map results for {location.city} searches
            is the ongoing work: Google Business Profile, citations, reviews and a monthly report
            you can actually read.
          </p>
          <a href="/local-seo">
            Learn About Local SEO
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </article>
    </div>
  </section>

  <HomeBeforeAfter />

  <FinalCta heading={`Ready To Get Found in ${location.city}?`} ctaLabel="Get A Free Homepage Mockup" ctaHref={mockupHref} />
</PeakLayout>
