---
import PeakLayout from "../layouts/PeakLayout.astro";
import FinalCta from "../components/FinalCta.astro";
import RecentWork from "../components/RecentWork.astro";
import { splitPartial } from "../lib/partial";
import "../styles/peak-about.css";
import html from "../partials/about-main.html?raw";

const aboutHtml = html;

const [
  beforeTestimonials,
  afterTestimonials,
  afterFinalCta,
] = splitPartial(
  aboutHtml,
  "about-main.html",
  "<!--TESTIMONIALS-->",
  "<!--FINAL_CTA-->",
);
---

<PeakLayout
  title="About PeakRanking | Small Business Web Design in Marietta, GA"
  description="Meet Manny Pachano, the designer and developer behind PeakRanking Digital Solutions. Custom websites at $80 per page and local SEO for small businesses."
  canonicalPath="/about"
>
  <Fragment set:html={beforeTestimonials} />
  <RecentWork tone="deep" id="work" />
  <Fragment set:html={afterTestimonials} />
  <FinalCta heading="Ready To Get The Site You Always Wanted?" ctaLabel="Get Started Today" />
  <Fragment set:html={afterFinalCta} />
</PeakLayout>
