---
import PeakLayout from "../../layouts/PeakLayout.astro";
import FinalCta from "../../components/FinalCta.astro";
import { splitPartial } from "../../lib/partial";
import "../../styles/peak-blog-post.css";
import html from "../../partials/blog-slow-website-main.html?raw";

const [beforeCta, afterCta] = splitPartial(
  html,
  "blog-slow-website-main.html",
  "<!--FINAL_CTA-->",
);
---

<PeakLayout
  title="Why Your Slow Website Is Costing You Leads"
  description="A 3-second delay can cost you half your traffic. Here's why slow websites lose leads, what's actually slowing yours down, and the fixes that move the needle."
  canonicalPath="/blog/why-your-slow-website-costs-leads"
  bodyClass="page-blog-post"
  ogType="article"
  article={{
    headline: "Why Your Slow Website Is Costing You Leads (And How To Fix It)",
    publishedTime: "2026-03-12T12:00:00.000Z",
    modifiedTime: "2026-03-12T12:00:00.000Z",
    authorName: "Manny Pachano",
  }}
>
  <Fragment set:html={beforeCta} />
  <FinalCta heading="Ready For A Website That Actually Loads?" ctaLabel="Get A Free Site Audit" ctaHref="/contact?service=free-audit" />
  <Fragment set:html={afterCta} />
</PeakLayout>
