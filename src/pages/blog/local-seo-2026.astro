---
import PeakLayout from "../../layouts/PeakLayout.astro";
import FinalCta from "../../components/FinalCta.astro";
import { splitPartial } from "../../lib/partial";
import "../../styles/peak-blog-post.css";
import html from "../../partials/blog-local-seo-2026-main.html?raw";

const [beforeCta, afterCta] = splitPartial(
  html,
  "blog-local-seo-2026-main.html",
  "<!--FINAL_CTA-->",
);
---

<PeakLayout
  title="Local SEO in 2026: What Small Businesses Need To Do"
  description="Local SEO has changed a lot in the last few years. Here's what actually works in 2026 for small businesses that want to rank on Google and show up in Maps."
  canonicalPath="/blog/local-seo-2026"
  bodyClass="page-blog-post page-blog-post--blue-hero"
  ogType="article"
  article={{
    headline: "Local SEO in 2026: What Small Businesses Actually Need To Do",
    publishedTime: "2026-02-24T12:00:00.000Z",
    modifiedTime: "2026-02-24T12:00:00.000Z",
    authorName: "Manny Pachano",
  }}
>
  <Fragment set:html={beforeCta} />
  <FinalCta heading="Ready To Climb The Local Rankings?" ctaLabel="Get A Free Site Audit" ctaHref="/contact?service=free-audit" />
  <Fragment set:html={afterCta} />
</PeakLayout>
