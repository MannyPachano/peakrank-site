---
import PeakLayout from "../../layouts/PeakLayout.astro";
import FinalCta from "../../components/FinalCta.astro";
import { splitPartial } from "../../lib/partial";
import "../../styles/peak-blog-post.css";
import html from "../../partials/blog-no-wordpress-wix-main.html?raw";

const [beforeCta, afterCta] = splitPartial(
  html,
  "blog-no-wordpress-wix-main.html",
  "<!--FINAL_CTA-->",
);
---

<PeakLayout
  title="Why I Don't Build On WordPress, Wix, Or Page Builders | PeakRanking"
  description="Why I hand-code small business websites instead of using WordPress, Wix or a page builder, and what that means for speed and cost."
  canonicalPath="/blog/why-no-wordpress-wix-page-builders"
  bodyClass="page-blog-post page-blog-post--navy-hero"
  ogType="article"
  article={{
    headline: "Why I Don't Build On WordPress, Wix, Or Page Builders",
    publishedTime: "2026-01-18T12:00:00.000Z",
    modifiedTime: "2026-01-18T12:00:00.000Z",
    authorName: "Manny Pachano",
  }}
>
  <Fragment set:html={beforeCta} />
  <FinalCta heading="Ready For A Site Built The Right Way?" ctaLabel="Get Started Today" />
  <Fragment set:html={afterCta} />
</PeakLayout>
