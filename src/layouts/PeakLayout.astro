---
import robotoLatin400Woff from "@fontsource/roboto/files/roboto-latin-400-normal.woff2?url";
import robotoLatin700Woff from "@fontsource/roboto/files/roboto-latin-700-normal.woff2?url";
import robotoLatin500Woff from "@fontsource/roboto/files/roboto-latin-500-normal.woff2?url";
import robotoSlabLatin700Woff from "@fontsource/roboto-slab/files/roboto-slab-latin-700-normal.woff2?url";
import robotoSlabLatin800Woff from "@fontsource/roboto-slab/files/roboto-slab-latin-800-normal.woff2?url";

import "@fontsource/roboto/latin-400.css";
import "@fontsource/roboto/latin-500.css";
import "@fontsource/roboto/latin-700.css";
import "@fontsource/roboto-slab/latin-500.css";
import "@fontsource/roboto-slab/latin-700.css";
import "@fontsource/roboto-slab/latin-800.css";

import { business } from "../data/business";
import "../styles/peak-shared.css";
import PeakHeader from "../components/PeakHeader.astro";
import PeakFooter from "../components/PeakFooter.astro";

interface ArticleMeta {
  headline: string;
  /** ISO 8601 */
  publishedTime: string;
  /** ISO 8601; defaults to publishedTime */
  modifiedTime?: string;
  authorName: string;
}

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  /** Extra class on <main> (e.g. layout hooks for full-height 404). */
  mainClass?: string;
  canonicalPath?: string;
  /** Omit canonical + use site URL for og:url (e.g. 404 pages). */
  suppressCanonical?: boolean;
  /** e.g. "noindex, follow" for legal pages */
  robots?: string;
  /** Path (e.g. /og-image.svg) or absolute image URL */
  ogImage?: string;
  ogType?: "website" | "article";
  article?: ArticleMeta;
}

const {
  title,
  description,
  bodyClass = "",
  mainClass,
  canonicalPath,
  suppressCanonical = false,
  robots,
  ogImage = "/og-image.png",
  ogType = "website",
  article,
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? "https://peakrankingseo.com";

/**
 * GA4. Renders nothing unless PUBLIC_GA_ID is set, so local builds and previews
 * stay clean. Set it in Netlify under Site configuration, Environment variables.
 * The googletagmanager host is already allowed in the netlify.toml CSP; any other
 * third-party script needs adding there too or the browser blocks it silently.
 */
const gaId = import.meta.env.PUBLIC_GA_ID;

const canonical = suppressCanonical
  ? null
  : canonicalPath != null
    ? new URL(canonicalPath, Astro.site).toString()
    : new URL(Astro.url.pathname, Astro.site).toString();

const ogUrl = canonical ?? `${siteOrigin}/`;
const organizationId = `${siteOrigin}/#organization`;
const websiteId = `${siteOrigin}/#website`;

const ogImageUrl = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage.replace(/^\//, ""), Astro.site).href;

const graph: Record<string, unknown>[] = [
  {
    "@type": ["LocalBusiness", "ProfessionalService"],
    "@id": organizationId,
    name: "PeakRanking Digital Solutions",
    url: `${siteOrigin}/`,
    email: "hello@peakrankingseo.com",
    telephone: "+1-678-793-2445",
    description:
      "Custom websites for small businesses at $75 per designed page, and local SEO with a refund if agreed targets are not met.",
    address: {
      "@type": "PostalAddress",
      addressLocality: business.address.locality,
      addressRegion: business.address.region,
      addressCountry: business.address.country,
      ...(business.address.postalCode
        ? { postalCode: business.address.postalCode }
        : {}),
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: business.geo.latitude,
      longitude: business.geo.longitude,
    },
    areaServed: { "@type": "Country", name: "United States" },
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday",
        ],
        opens: business.hours.opens,
        closes: business.hours.closes,
      },
    ],
    priceRange: "$$",
    image: ogImageUrl,
    // Google wants a raster logo of at least 112px on its shortest side.
    logo: `${siteOrigin}/og-image.png`,
    ...(business.profiles.length ? { sameAs: [...business.profiles] } : {}),
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: `${siteOrigin}/`,
    name: "PeakRanking Digital Solutions",
    publisher: { "@id": organizationId },
  },
];

if (article && ogType === "article") {
  const pageUrl = canonical ?? ogUrl;
  graph.push({
    "@type": "BlogPosting",
    headline: article.headline,
    description,
    url: pageUrl,
    datePublished: article.publishedTime,
    dateModified: article.modifiedTime ?? article.publishedTime,
    author: {
      "@type": "Person",
      name: article.authorName,
    },
    publisher: { "@id": organizationId },
    mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
    image: ogImageUrl,
  });
}

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {robots != null && robots !== "" && <meta name="robots" content={robots} />}
    {canonical != null && <link rel="canonical" href={canonical} />}
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="PeakRanking Digital Solutions" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="PeakRanking Digital Solutions, small business web design and local SEO" />
    <meta property="og:locale" content="en_US" />
    {
      ogType === "article" && article != null && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          <meta
            property="article:modified_time"
            content={article.modifiedTime ?? article.publishedTime}
          />
          <meta property="article:author" content={article.authorName} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="PeakRanking Digital Solutions, small business web design and local SEO" />

    <link
      rel="preload"
      href={robotoLatin400Woff}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={robotoLatin700Woff}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={robotoLatin500Woff}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={robotoSlabLatin700Woff}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={robotoSlabLatin800Woff}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={structuredData} is:inline />
    {
      gaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} is:inline />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`}
          />
          {/* GA4 enhanced measurement ignores tel:, sms: and mailto: clicks. */}
          <script
            is:inline
            set:html={`document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('a[href^="tel:"],a[href^="sms:"],a[href^="mailto:"]');if(!a||!window.gtag)return;var h=a.getAttribute('href')||'';var t=h.indexOf('mailto:')===0?'email':h.indexOf('sms:')===0?'text':'call';gtag('event','contact_click',{method:t,link_url:h});});`}
          />
        </>
      )
    }
  </head>
  <body class:list={[bodyClass]}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <PeakHeader currentPath={Astro.url.pathname} />
    <main id="main-content" tabindex="-1" class:list={[mainClass]}>
      <slot />
    </main>
    <PeakFooter />
    <script src="/js/peak-nav.js" defer is:inline></script>
  </body>
</html>
