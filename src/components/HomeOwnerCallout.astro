---
import { Image } from "astro:assets";
import portrait from "../assets/manny-avatar.jpg";
import { business } from "../data/business";
---

<section class="owner-callout" id="about">
  <div class="owner-inner">
    <a href={business.smsHref} class="btn-primary">Text {business.phoneDisplay}</a>
    <div class="owner-photo">
      <Image
        src={portrait}
        alt="Manny Pachano, Owner and Developer at PeakRanking Digital Solutions"
        width={140}
        height={140}
        densities={[1, 2]}
        loading="lazy"
        decoding="async"
        quality={82}
        class="owner-photo-img"
      />
    </div>
    <div class="owner-name">Manny Pachano</div>
    <div class="owner-role">Owner, Developer</div>
  </div>
</section>
