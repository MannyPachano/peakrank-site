---
import { business } from "../data/business";
---

<section class="owner-callout" id="about">
  <div class="owner-inner">
    <a href={business.smsHref} class="btn-primary">Text {business.phoneDisplay}</a>
    <div class="owner-photo owner-photo--initials" role="img" aria-label="Manny Pachano, Owner and Developer">
      <span aria-hidden="true">MP</span>
    </div>
    <div class="owner-name">Manny Pachano</div>
    <div class="owner-role">Owner, Developer</div>
  </div>
</section>

<style>
  .owner-photo--initials {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    font-family: "Roboto Slab", Georgia, serif;
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--bg);
  }
</style>
