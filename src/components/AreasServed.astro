---
import { locations } from "../data/locations";

/**
 * Internal links from the two service pages to the location pages, so those
 * pages get real internal PageRank instead of sitting orphaned in the sitemap.
 */
interface Props {
  /** Omit a city when rendering this on that city's own page. */
  exclude?: string;
}

const { exclude } = Astro.props;
const shown = locations.filter((location) => location.slug !== exclude);
---

<div class="areas-served">
  <h2>Areas I Serve</h2>
  <p>
    I work with small businesses across the US, and I know metro Atlanta best because I grew up
    here. These are the areas I get asked about most.
  </p>
  <ul class="areas-served-list">
    {
      shown.map((location) => (
        <li>
          <a href={`/web-design-${location.slug}`}>
            {/*
              The visible city sits in its own span for styling, so the link read out
              as "Kennesaw, GA Kennesaw web design and local SEO". The sr-only words
              make the accessible name a sentence; the note is hidden from the name
              because it is a duplicate of it.
            */}
            <span class="areas-served-city">
              <span class="sr-only">Web design in </span>
              {location.city}, GA
            </span>
            <span class="areas-served-note" aria-hidden="true">
              {location.shortName} web design and local SEO
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
