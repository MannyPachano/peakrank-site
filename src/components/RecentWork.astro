---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import "../styles/peak-testimonials.css";
import { projects } from "../data/projects";

interface Props {
  tone?: "base" | "deep";
  id?: string;
  title?: string;
  intro?: string;
}

const {
  tone = "deep",
  id,
  title = "Websites Manny Has Designed And Built",
  intro = "Client sites and in-house work from the last few years. Each one links to a case study with what the project needed and what was built.",
} = Astro.props;

/**
 * Resolved at build time so a missing or renamed file in src/assets/work fails
 * the build instead of shipping a broken <img>.
 */
const assets = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/work/*.{webp,png}",
  { eager: true },
);

function shotFor(file: string | undefined): ImageMetadata | null {
  if (!file) return null;
  const hit = assets[`../assets/work/${file}`];
  if (!hit) throw new Error(`src/assets/work/${file} is missing (src/data/projects.ts).`);
  return hit.default;
}
---

<section class:list={["testimonials", `testimonials--${tone}`]} id={id}>
  <div class="container">
    <div class="section-eyebrow">Recent Work</div>
    <h2 class="section-title">{title}</h2>
    <p class="section-intro">{intro}</p>

    <div class="testimonial-grid">
      {
        projects.map((p) => {
          const shot = shotFor(p.image);
          const alt = `Homepage of ${p.name}, designed and built by Manny Pachano`;
          return (
            <article class="testimonial work-card">
              {shot && (
                <div class="work-shot-box">
                  <Image
                    src={shot}
                    alt={alt}
                    width={640}
                    height={400}
                    widths={[320, 640]}
                    sizes="(max-width: 960px) calc(100vw - 3rem), min(360px, 30vw)"
                    loading="lazy"
                    decoding="async"
                    quality={74}
                  />
                </div>
              )}
              <div class="work-body">
                <h3 class="testimonial-name work-name">{p.name}</h3>
                <p class="testimonial-loc work-role">{p.role}</p>
                <p class="testimonial-body work-summary">{p.summary}</p>
                <p class="work-links">
                  <a href={p.caseStudy} target="_blank" rel="noopener">
                    Read the {p.name} case study<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                  {p.live && (
                    <a href={p.live} target="_blank" rel="noopener">
                      Visit the live site<span class="sr-only"> (opens in a new tab)</span>
                    </a>
                  )}
                </p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  /* Two classes so this beats .testimonial's padding in peak-testimonials.css
     whichever order the inlined stylesheets end up in. */
  .testimonial.work-card { display: flex; flex-direction: column; padding: 0; overflow: hidden; }
  .work-body { display: flex; flex-direction: column; flex: 1; padding: 1.75rem; }
  .work-name { font-size: 1.125rem; margin: 0 0 0.25rem; }
  .work-role { margin: 0 0 0.875rem; }
  .work-summary { margin: 0 0 1.25rem; }
  .work-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: auto 0 0; font-weight: 600; }
  /* Without an explicit colour these fall back to the UA default #0000EE,
     which is 1.69:1 on the card. --accent is 7.0:1 and matches the site. */
  .work-links a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .work-links a:hover { color: var(--accent-bright); }

  /* Every shot is cropped to the same 16:10 box from the top, so the grid lines
     up whatever the source dimensions are. */
  .work-shot-box {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--bg-deep);
  }

  .work-shot-box :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

</style>
