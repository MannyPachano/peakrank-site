---
import { business } from "../data/business";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
const is = (p: string) =>
  p === "/"
    ? currentPath === "/" || currentPath === ""
    : currentPath === p || currentPath.startsWith(p + "/");
---

<nav>
  <div class="nav-inner">
    <a href="/" class="logo">
      <span class="logo-mark">
        <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="20" cy="20" r="19" fill="#FF8A3D" stroke="#FFA05C" stroke-width="1"></circle>
          <path d="M8 28 L16 14 L22 22 L26 16 L32 28 Z" fill="#0B1A2F"></path>
          <circle cx="28" cy="10" r="2" fill="#FFD56B"></circle>
        </svg>
      </span>
      <span>PeakRanking</span>
    </a>
    <ul class="nav-links" id="primary-nav">
      <li class="has-dropdown">
        <a href="/web-design">
          Services
          <svg
            class="dropdown-arrow"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <ul class="dropdown">
          <li>
            <a href="/web-design" class:list={{ active: is("/web-design") }}>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
              Web Design
            </a>
          </li>
          <li>
            <a href="/local-seo" class:list={{ active: is("/local-seo") }}>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              Local SEO
            </a>
          </li>
        </ul>
      </li>
      <li>
        <a href="/pricing" class:list={{ active: is("/pricing") }}>Pricing</a>
      </li>
      <li>
        <a href="/about" class:list={{ active: is("/about") }}>About</a>
      </li>
      <li>
        <a href="/blog" class:list={{ active: is("/blog") }}>Blog</a>
      </li>
      <li>
        <a href="/contact" class:list={{ active: is("/contact") }}>Contact</a>
      </li>
      <li>
        <a href={business.smsHref} class="nav-phone">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          {business.phoneDisplay}
        </a>
      </li>
      <li><a href="/contact" class="nav-cta">Get Started</a></li>
    </ul>
    <a
      href={business.smsHref}
      class="nav-call"
      aria-label={`Text ${business.phoneDisplay}`}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      <span>{business.phoneDisplay}</span>
    </a>
    <button
      class="hamburger"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
