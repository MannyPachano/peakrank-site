---
import { Image } from "astro:assets";
import portrait from "../assets/manny-portrait.jpg";
import { business, claims } from "../data/business";

const perks = [
  {
    title: "No Database To Break Into",
    body: "Your site is static HTML and CSS files. There is no database, no admin login and no plugins, so the entire class of CMS and plugin exploits simply does not apply to it. Domain and hosting accounts are locked down with two-factor authentication.",
  },
  {
    title: "Custom Designed",
    body: "Every design is drawn from scratch by the person who builds your site, so it looks like your business instead of a template somebody else is also using.",
  },
  {
    title: claims.pageSpeedShort,
    body: "The sites ship with no page builder bloat and no unused code, so they load fast on a phone. Run your current site through Google PageSpeed Insights and compare.",
  },
  {
    title: "Money Back Guarantee",
    body: "If we cannot design something you want to put your name on, you get your money back and the contract is cancelled.",
    link: { href: "/terms#guarantee", label: "Read the guarantee terms" },
  },
  {
    title: "You Get The Owner",
    body: "Text or call and you reach the person who designed and built your site. No phone trees, no chatbots, no account manager relaying messages.",
  },
  {
    title: "We Know SEO",
    body: "No tricks and no gimmicks. We will explain what SEO actually is, how it works, and what we can realistically do to get your business ranking.",
  },
];
---

<section class="offer">
  <div class="container">
    <div class="offer-split">
      <figure class="offer-photo">
        <Image
          src={portrait}
          alt="Manny Pachano, Owner and Developer at PeakRanking Digital Solutions"
          width={572}
          height={1024}
          widths={[380, 572]}
          sizes="(max-width: 960px) 100vw, min(520px, 42vw)"
          loading="lazy"
          decoding="async"
          quality={82}
          class="offer-portrait-img"
        />
      </figure>
      <div class="offer-lead">
        <div class="section-eyebrow">What We Offer</div>
        <h2 class="section-title">$0 Down, $150 Per Month</h2>
        <p class="section-intro">
          The monthly plan covers a standard 5 page small business website and includes design,
          development, hosting, unlimited edits, direct access to the owner and updates for as long
          as the plan is active. Six month minimum. Larger sites are priced on scope and page count,
          and there is a one time option on the <a href="/pricing">pricing page</a> if you would
          rather pay once.
        </p>

        <div class="perks-grid">
          {
            perks.map((perk) => (
              <div class="perk">
                <div class="perk-check">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                </div>
                <h3>{perk.title}</h3>
                <p>{perk.body}</p>
                {perk.link && (
                  <p class="perk-link">
                    <a href={perk.link.href}>{perk.link.label}</a>
                  </p>
                )}
              </div>
            ))
          }
        </div>

        <div class="offer-cta">
          <a href="/contact" class="btn-primary">
            Get Started
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a href={business.smsHref} class="offer-call">
            or text {business.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
