---
import { Image } from "astro:assets";
import photo from "../assets/manny-geese.webp";
import { business, claims } from "../data/business";

const perks = [
  {
    title: "Edit Your Own Site Safely",
    body: "You get a custom editor for changing text, photos and prices yourself. The public site stays plain static files with no database and no plugins, so the usual WordPress break-ins do not apply to it. Every account is protected with two-factor authentication.",
  },
  {
    title: "Custom Designed",
    body: "I draw every design from scratch, so it looks like your business instead of a template somebody else is also using.",
  },
  {
    title: claims.pageSpeedShort,
    body: "The sites ship with no page builder bloat and no unused code, so they load fast on a phone. Run your current site through Google PageSpeed Insights and compare.",
  },
  {
    title: "Money Back Guarantee On Design",
    body: "Revisions are unlimited until you approve the design. If you are still not satisfied, you get your money back and the contract is cancelled.",
    link: { href: "/terms#guarantee", label: "Read the guarantee terms" },
  },
  {
    title: "You Get The Owner",
    body: "Text or call and you reach the person who designed and built your site. No phone trees, no chatbots, no account manager relaying messages.",
  },
  {
    title: "SEO Results Or A Refund",
    body: "Before SEO work starts, we agree in writing on the targets it has to hit. If they are not met after the four month minimum, you get back what you paid.",
    link: { href: "/terms#seo-guarantee", label: "Read the SEO guarantee terms" },
  },
];
---

<section class="offer">
  <div class="container">
    <div class="offer-split">
      <figure class="offer-photo">
        <Image
          src={photo}
          alt="Manny Pachano crouching on a lawn, holding out a hand to two Canada geese"
          width={800}
          height={500}
          widths={[400, 800]}
          sizes="(max-width: 960px) 100vw, min(520px, 42vw)"
          loading="lazy"
          decoding="async"
          quality={82}
          class="offer-portrait-img"
        />
      </figure>
      <div class="offer-lead">
        <div class="section-eyebrow">What You Get</div>
        <h2 class="section-title">Website Redesigns At $80 Per Page</h2>
        <p class="section-intro">
          I design every page from scratch, and you can ask for as many design revisions as you
          need. A 5 page site is $400, paid half to start and half at launch. You get a custom editor
          to make changes yourself and one month of unlimited support after launch. Local SEO is
          $799 per month with a refund if the agreed targets are not met. Details are on the
          <a href="/pricing">pricing page</a>.
        </p>

        <div class="perks-grid">
          {
            perks.map((perk) => (
              <div class="perk">
                <div class="perk-check">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                </div>
                <h3>{perk.title}</h3>
                <p>{perk.body}</p>
                {perk.link && (
                  <p class="perk-link">
                    <a href={perk.link.href}>{perk.link.label}</a>
                  </p>
                )}
              </div>
            ))
          }
        </div>

        <div class="offer-cta">
          <a href="/contact" class="btn-primary">
            Get Started
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a href={business.smsHref} class="offer-call">
            or text {business.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
