---
import { business } from "../data/business";

/**
 * The owner badge used on the long-form service pages. Shows initials until a
 * real photo of Manny is added (the previous image was AI generated).
 */
interface Props {
  caption?: string;
}

const { caption = `Based in ${business.address.locality}, ${business.address.region}. Working with small businesses nationwide.` } =
  Astro.props;
---

<div class="owner-photo-inline">
  <div class="owner-circle" role="img" aria-label="Manny Pachano, Owner and Developer">
    <span class="owner-circle-initials" aria-hidden="true">MP</span>
  </div>
  <p class="owner-caption">{caption}</p>
</div>

<style>
  .owner-circle-initials {
    position: relative;
    font-family: "Roboto Slab", Georgia, serif;
    font-size: 4rem;
    font-weight: 800;
    color: var(--bg);
    letter-spacing: -0.02em;
  }
</style>
